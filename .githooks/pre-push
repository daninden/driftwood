#!/bin/sh
# pre-push hook: the full test suite must be green before anything reaches main.
#
# What it does: reads the refs git is about to push from stdin; if any of them
# targets refs/heads/main it runs `npm test` and refuses the push (non-zero
# exit) when the suite fails. Pushes to other branches are not checked.
# Enable once per clone: git config core.hooksPath .githooks
# Bypass (only with the user's explicit permission): git push --no-verify

# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
to_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    to_main=1
  fi
done

if [ "$to_main" = "1" ]; then
  echo "pre-push: pushing to main, running the full test suite (npm test)..."
  if ! npm test; then
    echo "pre-push: tests failed, push refused. Fix the tests; bypass only with the user's explicit permission (git push --no-verify)." >&2
    exit 1
  fi
fi
exit 0
