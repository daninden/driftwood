{
  "name": "driftwood",
  "private": true,
  "version": "0.36.2",
  "description": "A stylised, diorama-like game on an uninhabited island.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/inline.js",
    "test": "vitest run",
    "test:fast": "vitest run --exclude \"tests/mindLife*.test.js\" --exclude tests/mindSim.test.js",
    "test:sim": "vitest run tests/mindLife tests/mindSim.test.js",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.js",
    "smoke:quality": "node scripts/quality-smoke.js",
    "smoke:hands": "node scripts/hands-smoke.js",
    "smoke:voice": "node scripts/voice-smoke.js",
    "smoke:full": "node scripts/smoke.js --full",
    "smoke:axe": "node scripts/axe-smoke.js",
    "smoke:hut": "node scripts/hut-smoke.js",
    "smoke:moonless": "node scripts/moonless-smoke.js",
    "playtest": "node scripts/playtest.js"
  },
  "dependencies": {
    "three": "0.128.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
